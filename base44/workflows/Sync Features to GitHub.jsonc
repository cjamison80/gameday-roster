  "name": "Sync Features to GitHub",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_features_to_github",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_features": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFeaturesToGitHub"
          },
          "then": "end",
          "x-base44": {
            "title": "Sync features to GitHub",
            "description": "Post pending FeatureRequest records as issues"
          }
        }
      }
    ]
  },
  "description": "Daily batch \u2014 posts pending GameDay Roster FeatureRequest records as GitHub issues"
