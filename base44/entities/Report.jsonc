{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_user_id": {
      "type": "string"
    },
    "reported_user_id": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "player",
        "coach",
        "team",
        "organization",
        "opportunity",
        "message",
        "tournament",
        "user",
        "other"
      ],
      "default": "other"
    },
    "target_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "safety",
        "minor_safety",
        "harassment",
        "fake_profile",
        "inaccurate_information",
        "inappropriate_content",
        "spam",
        "billing",
        "other"
      ],
      "default": "other"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewing",
        "resolved",
        "dismissed"
      ],
      "default": "open"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "admin_notes": {
      "type": "string"
    },
    "resolved_by_user_id": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "action_taken": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "target_type",
    "category",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "reporter_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}