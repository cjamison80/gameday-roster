{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "coach_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "pickup",
        "tryout",
        "recruiting"
      ],
      "default": "pickup"
    },
    "sport": {
      "type": "string",
      "default": "baseball"
    },
    "sanctioning_body": {
      "type": "string",
      "enum": [
        "USSSA",
        "2D",
        "PG",
        "NSA",
        "AAU",
        "Other",
        ""
      ],
      "default": "",
      "description": "Tournament sanctioning body this event is played under"
    },
    "description": {
      "type": "string"
    },
    "positions_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "age_division": {
      "type": "string"
    },
    "classification": {
      "type": "string",
      "enum": [
        "Major",
        "AAA",
        "AA",
        "A",
        ""
      ]
    },
    "event_date_start": {
      "type": "string",
      "format": "date"
    },
    "event_date_end": {
      "type": "string",
      "format": "date"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "player_cost": {
      "type": "number"
    },
    "games_count": {
      "type": "integer"
    },
    "spots_available": {
      "type": "integer"
    },
    "spots_filled": {
      "type": "integer",
      "default": 0
    },
    "overnight_required": {
      "type": "boolean",
      "default": false
    },
    "application_deadline": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "closed"
      ],
      "default": "active"
    },
    "requirements": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "coach_id",
    "event_date_start"
  ]
}