{
  "name": "PlayerProfile",
  "type": "object",
  "properties": {
    "parent_id": {
      "type": "string",
      "description": "User ID of the parent/guardian who owns this profile (or the player themselves for self-managed 18+ accounts)"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "birth_year": {
      "type": "integer"
    },
    "graduation_year": {
      "type": "integer"
    },
    "sport": {
      "type": "string",
      "default": "baseball",
      "enum": [
        "baseball",
        "softball",
        "basketball",
        "soccer",
        "lacrosse",
        "football",
        "volleyball"
      ]
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bats": {
      "type": "string",
      "enum": [
        "Right",
        "Left",
        "Switch",
        ""
      ]
    },
    "throws": {
      "type": "string",
      "enum": [
        "Right",
        "Left",
        ""
      ]
    },
    "height_inches": {
      "type": "integer"
    },
    "weight_lbs": {
      "type": "integer"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "travel_radius_miles": {
      "type": "integer",
      "default": 100
    },
    "age_division": {
      "type": "string"
    },
    "classification": {
      "type": "string",
      "enum": [
        "Major",
        "AAA",
        "AA",
        "A",
        ""
      ]
    },
    "sanctioning_body": {
      "type": "string",
      "enum": [
        "USSSA",
        "2D",
        "PG",
        "NSA",
        "AAU",
        "Other",
        ""
      ],
      "default": ""
    },
    "highlight_video_url": {
      "type": "string"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "current_team_name": {
      "type": "string"
    },
    "gpa": {
      "type": "number"
    },
    "gamechanger_url": {
      "type": "string",
      "description": "Optional link to the player's GameChanger page"
    },
    "sidelinehd_url": {
      "type": "string",
      "description": "Optional link to the player's Sideline HD page"
    },
    "guardian_name": {
      "type": "string",
      "description": "Full name of the parent/guardian who manages this page (or the player for self-managed accounts)"
    },
    "guardian_relationship": {
      "type": "string",
      "enum": [
        "Mother",
        "Father",
        "Legal Guardian",
        "Grandparent",
        "Self",
        "Other",
        ""
      ],
      "default": ""
    },
    "guardian_email": {
      "type": "string"
    },
    "guardian_phone": {
      "type": "string"
    },
    "has_accepted_parental_terms": {
      "type": "boolean",
      "default": false,
      "description": "Parent/guardian (or adult player) acknowledged that player pages are parent-run and must comply with safety terms"
    },
    "parental_terms_accepted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "parent_id"
  ]
}