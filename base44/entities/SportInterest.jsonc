{
  "name": "SportInterest",
  "properties": {
    "sport": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "sport",
    "user_id"
  ],
  "rls": {
    "create": {},
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}