{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "application_received",
        "application_accepted",
        "application_declined",
        "invitation_received",
        "message_received",
        "availability_reminder",
        "opportunity_match",
        "verification_update",
        "system"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "related_id": {
      "type": "string"
    },
    "related_type": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "action_url": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "type",
    "title"
  ]
}