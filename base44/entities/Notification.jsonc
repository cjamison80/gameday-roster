{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "application_received",
        "application_accepted",
        "application_declined",
        "invitation_received",
        "message_received",
        "availability_reminder",
        "opportunity_match",
        "verification_update",
        "billing",
        "system"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "related_id": {
      "type": "string"
    },
    "related_type": {
      "type": "string"
    },
    "source_user_id": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "channel": {
      "type": "string",
      "enum": [
        "in_app",
        "push",
        "email",
        "sms"
      ],
      "default": "in_app"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "queued",
        "delivered",
        "failed",
        "suppressed"
      ],
      "default": "delivered"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "action_url": {
      "type": "string"
    },
    "channel_snapshot": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "user_id",
    "type",
    "title"
  ]
}